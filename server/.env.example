PORT=5000
# Leave MONGO_URI empty to use an in-memory database seeded with demo data
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional – Google Meet: lets tutors connect Google so Meet links are created automatically.
# Without these, tutors paste a Meet link by hand. See README "Google Meet setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <this server>/api/google/callback; must match Google Cloud's "Authorized redirect URIs".
GOOGLE_REDIRECT_URI=
